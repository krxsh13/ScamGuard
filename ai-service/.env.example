# AI Service Environment Variables
# Copy this file to .env.local and fill in actual values

# Environment & Server
PYTHON_ENV=development
PORT=8000

# ML Model Configuration
# Hugging Face model identifier for scam detection
MODEL_PATH=distilbert-base-uncased

# OCR Configuration
# Language codes: eng (English), multiple languages can be used (comma-separated)
OCR_LANGUAGE=eng

# File Upload Configuration
# Maximum image file size for upload (in MB)
MAX_IMAGE_SIZE_MB=5

# Performance & Caching
# Enable/disable caching of model predictions to Redis
CACHE_PREDICTIONS=false

# CORS Configuration
# Allowed origins for cross-origin requests (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
