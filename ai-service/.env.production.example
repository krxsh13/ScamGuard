# AI Service Production Environment Variables
# Optimized for production with minimal logging and maximum caching

# Environment & Logging
ENVIRONMENT=production
LOG_LEVEL=warn

# Server Configuration
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0

# ML Model Configuration
# Path to pre-trained models directory (typically in /app/models inside container)
MODEL_PATH=/app/models/

# Cache Configuration
# Enable Redis caching for better performance and reduced latency
CACHE_ENABLED=true
CACHE_TTL=7200

# OCR Configuration
# Path to Tesseract OCR engine (installed via Docker)
TESSERACT_PATH=/usr/bin/tesseract

# PyTorch Configuration
# Enable fallback for MPS (Metal Performance Shaders) on macOS
PYTORCH_ENABLE_MPS_FALLBACK=1

# Endpoints to expose
ENABLE_HEALTH_CHECK=true
ENABLE_ANALYTICS=true

# Performance and Limits
MAX_REQUEST_SIZE=20971520
REQUEST_TIMEOUT=30

# Monitoring
SENTRY_DSN=${SENTRY_DSN}
