# ScamGuard Root Environment Variables
# Copy this file to .env.local and fill in actual values for local development

# Frontend Configuration
VITE_API_URL=http://localhost:4000
VITE_API_TIMEOUT=30000

# Observability - Frontend Error Tracking
# Get DSN from: https://sentry.io/
VITE_SENTRY_DSN=

# Notes:
# - Backend environment variables are in: backend/.env.local
# - AI Service variables are in: ai-service/.env.local
# - To set up the full development environment, see: README.md
