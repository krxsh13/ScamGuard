# Backend Development Environment Variables
# Copy this file to .env.development and update values as needed

# Node Environment
NODE_ENV=development
LOG_LEVEL=debug

# API Configuration
API_PORT=4000
API_HOST=localhost
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/scamguard
MONGODB_MAX_POOL_SIZE=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication
JWT_SECRET=your-jwt-secret-key-change-this-in-production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# Session
SESSION_SECRET=your-session-secret-key-change-this-in-production

# Email (if configured)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-email-password
SMTP_FROM=noreply@scamguard.local

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
FEATURE_EMAIL_VERIFICATION=false
FEATURE_TWO_FACTOR_AUTH=false

# Monitoring
SENTRY_DSN=
