# Backend Development Environment Variables
# Copy this file to .env.local and fill in actual values

# Server Configuration
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/scamguard
MONGODB_TEST_URI=mongodb://localhost:27017/scamguard_test

# Redis Cache
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Authentication - JWT Tokens
JWT_SECRET=your-very-long-secret-key-min-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-very-long-refresh-secret-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# AI Service (Internal)
AI_SERVICE_URL=http://localhost:8000

# External APIs - Security & Threat Intelligence
# Get keys from: Google Cloud Console, VirusTotal.com, PhishTank
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
PHISHTANK_API_KEY=

# Email Service (Resend)
# Get API key from: https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@scamguard.local
APP_BASE_URL=http://localhost:5173

# Security - CORS & Rate Limiting
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug

# Data Retention & Compliance
# How many days to keep scan and conversation data (GDPR compliance)
DATA_RETENTION_DAYS=90

# Observability - Error Tracking
# Get DSN from: https://sentry.io/
SENTRY_DSN=

# Observability - Distributed Tracing
# Set to OTLP collector URL (e.g., http://localhost:4317) to enable tracing
OTEL_EXPORTER_OTLP_ENDPOINT=

# Observability - Metrics Access Control
# IP addresses allowed to access /metrics endpoint (comma-separated)
METRICS_ALLOWLIST=127.0.0.1,localhost,::1,::ffff:127.0.0.1
