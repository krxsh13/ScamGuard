# Backend Production Environment Variables
# Sensitive values should be set via environment variables or secrets management
# DO NOT commit actual values to version control

NODE_ENV=production
LOG_LEVEL=warn

# API Configuration
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=https://scamguard.com

# Database
# Use environment variables or secrets management for actual credentials
MONGODB_URI=${MONGODB_URI}
MONGODB_MAX_POOL_SIZE=50

# Redis
REDIS_URL=${REDIS_URL}
REDIS_PASSWORD=${REDIS_PASSWORD}

# Authentication
# These MUST be set via environment variables in production
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRATION=7d

# Session
SESSION_SECRET=${SESSION_SECRET}

# Email
SMTP_HOST=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
SMTP_USER=${SMTP_USER}
SMTP_PASS=${SMTP_PASS}
SMTP_FROM=noreply@scamguard.com

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500

# Feature Flags
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=true

# Observability - Sentry
SENTRY_DSN=${SENTRY_DSN}

# Observability - OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}

# Observability - Metrics
METRICS_ALLOWLIST=10.0.0.0/8,127.0.0.1

# Security
ENCRYPTION_KEY=${ENCRYPTION_KEY}

# Backup and Disaster Recovery
BACKUP_ENABLED=true
BACKUP_INTERVAL=24h
