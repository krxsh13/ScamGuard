# Backend Staging Environment Variables
# Used for pre-production testing and staging environment

NODE_ENV=staging
LOG_LEVEL=info

# API Configuration
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=https://staging.scamguard.com

# Database
MONGODB_URI=mongodb+srv://user:password@staging-cluster.mongodb.net/scamguard
MONGODB_MAX_POOL_SIZE=20

# Redis
REDIS_URL=redis://staging-redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# Authentication
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_REFRESH_EXPIRATION=7d

# Session
SESSION_SECRET=${SESSION_SECRET}

# Email
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=${SENDGRID_API_KEY}
SMTP_FROM=noreply@staging.scamguard.com

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# Feature Flags
FEATURE_EMAIL_VERIFICATION=true
FEATURE_TWO_FACTOR_AUTH=false

# Observability - Sentry
SENTRY_DSN=${SENTRY_DSN}

# Observability - OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=${OTEL_EXPORTER_OTLP_ENDPOINT}

# Observability - Metrics
METRICS_ALLOWLIST=127.0.0.1,10.0.0.0/8
