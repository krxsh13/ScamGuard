# AI Service Development Environment Variables
# Optimized for local development with debug logging and caching enabled

# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=debug

# Server Configuration
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0

# ML Model Configuration
# Path to pre-trained models directory
MODEL_PATH=./models/

# Cache Configuration
# Enable Redis caching for improved performance
CACHE_ENABLED=true
CACHE_TTL=3600

# OCR Configuration
# Path to Tesseract OCR engine
TESSERACT_PATH=/usr/bin/tesseract

# PyTorch Configuration
# Enable fallback for MPS (Metal Performance Shaders) on macOS
PYTORCH_ENABLE_MPS_FALLBACK=1

# Endpoints to expose
ENABLE_HEALTH_CHECK=true
ENABLE_ANALYTICS=true
